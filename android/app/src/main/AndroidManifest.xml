<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Socket com o gerenciador-tarefas-servidor (porta 4321) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.NexProject">

        <activity
            android:name=".ui.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.CadastroActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.MainActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.ProjetoFormActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.TarefaFormActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.EntregaFormActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.InscricoesActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.TrocarSenhaActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.ChatActivity" android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
